{
  "metadata": {
    "name": "inline-users",
    "namespace": "default"
  },
  "spec": {
    "domainRef": {
      "name": "basic-domain"
    },
    "name": "Inline users",
    "type": "inline-am-idp",
    "system": false,
    "configuration": {
      "passwordEncoder": "BCrypt",
      "users": [
        {
          "username": "jdoe",
          "email": "john.doe@example.com",
          "password": "change-me"
        }
      ]
    },
    "domainWhitelist": ["example.com"],
    "groupMapper": {
      "admins": ["{#profile.group == 'admin'}"]
    },
    "mappers": {
      "email": "mail"
    },
    "roleMapper": {
      "domain-admin": ["{#profile.role == 'admin'}"]
    }
  }
}
