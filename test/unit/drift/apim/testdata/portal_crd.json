{
  "apiVersion": "gravitee.io/v1alpha1",
  "kind": "Portal",
  "metadata": {
    "name": "my-portal",
    "namespace": "default"
  },
  "spec": {
    "name": "My Portal",
    "contextRef": {
      "name": "dev-ctx"
    },
    "navigation": [
      {
        "path": "/projects/alpha",
        "displayName": "Alpha",
        "order": 1,
        "visibility": "PRIVATE"
      }
    ],
    "themeRef": {
      "name": "brand-theme",
      "kind": "PortalTheme"
    }
  }
}
